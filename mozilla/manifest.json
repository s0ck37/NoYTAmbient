{
	"manifest_version": 2,
	"name": "NoYTAmbient",
	"version": "1.0",

	"description": "Disable Youtube ambient mode.",

	"icons": {
		"48": "icons/noytambient-48.svg"
	},

	"browser_specific_settings": {
  		"gecko": {
    		"id": "@noytambient-no-data-collection",
    		"data_collection_permissions": {
      			"required": ["none"]
    		}
  		}
	},

	"content_scripts": [
		{
			"matches": ["*://www.youtube.com/*"],
			"js": ["noambient.js"]
		}
	]
}
